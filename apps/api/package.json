{
 "name": "@firma/api",
 "version": "0.1.0",
 "private": true,
 "type": "module",
 "scripts": {
  "build": "node scripts/copy-contract.mjs && tsc -p tsconfig.json",
  "typecheck": "tsc -p tsconfig.json --noEmit",
  "dev": "node --env-file-if-exists=.env --import tsx src/main.ts",
  "start": "node --env-file-if-exists=.env dist/main.js",
  "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
  "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
  "db:bootstrap": "node --env-file-if-exists=.env --import tsx scripts/bootstrap.ts",
  "worker": "node --env-file-if-exists=.env --import tsx scripts/worker.ts"
 },
 "dependencies": {
  "@aws-sdk/client-s3": "^3.0.0",
  "@aws-sdk/s3-request-presigner": "^3.1161.0",
  "@nestjs/common": "^12.3.2",
  "@nestjs/core": "^12.3.2",
  "@nestjs/platform-express": "^12.3.2",
  "ajv": "^8.17.1",
  "ajv-formats": "^3.0.1",
  "cookie": "^1.0.2",
  "csv-parse": "^7.0.3",
  "decimal.js": "^10.5.0",
  "helmet": "^8.1.0",
  "jose": "^6.0.0",
  "nodemailer": "^10.3.1",
  "pdfkit": "^0.17.0",
  "pg": "^8.16.0",
  "read-excel-file": "^9.3.14",
  "reflect-metadata": "^0.2.2",
  "rxjs": "^7.8.2"
 },
 "devDependencies": {
  "@electric-sql/pglite": "^0.3.0",
  "@types/express": "^5.0.0",
  "@types/node": "^22.0.0",
  "@types/nodemailer": "^7.0.0",
  "@types/pdfkit": "^0.17.0",
  "@types/pg": "^8.15.0",
  "@types/supertest": "^6.0.0",
  "supertest": "^7.1.0",
  "tsx": "^4.19.0",
  "typescript": "^5.8.0"
 },
 "engines": {
  "node": "22.x"
 }
}
